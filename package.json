{
  "name": "pawtropolis-tech",
  "version": "7.0.0",
  "description": "Server-owned Discord gatekeeping bot. Transparent, auditable, and minimal. Built by watchthelight (Bash).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "author": {
    "name": "watchthelight (Bash)",
    "email": "admin@watchthelight.org",
    "url": "https://watchthelight.org"
  },
  "license": "LicenseRef-ANW-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/watchthelight/pawtropolis-tech.git"
  },
  "bugs": {
    "url": "https://github.com/watchthelight/pawtropolis-tech/issues",
    "email": "admin@watchthelight.org"
  },
  "homepage": "https://github.com/watchthelight/pawtropolis-tech#readme",
  "scripts": {
    "dev": "npx @dotenvx/dotenvx run -- tsx watch src/index.ts",
    "build": "tsup && npm run scan:legacy",
    "start": "npx @dotenvx/dotenvx run -- node dist/index.js",
    "test": "vitest run",
    "deploy:cmds": "node dist/scripts/commands.js --all",
    "sync:cmds": "dotenvx run -- tsx scripts/commands.ts --all",
    "print:cmds": "dotenvx run -- tsx scripts/print-commands.ts",
    "auth:whoami": "dotenvx run -- tsx scripts/auth-check.ts",
    "scan:legacy": "tsx scripts/scan-legacy.ts",
    "migrate": "dotenvx run -- tsx scripts/migrate.ts",
    "migrate:dry": "dotenvx run -- tsx scripts/migrate.ts --dry-run",
    "stats:refresh": "dotenvx run -- tsx scripts/refresh-public-stats.ts",
    "migrate:logging": "dotenvx run -- tsx scripts/migrate-logging-channel.ts",
    "gen:test-schema": "tsx scripts/gen-test-schema.ts",
    "report:excel": "python scripts/report/build_workbook.py",
    "backfill:app-mappings": "dotenvx run -- tsx scripts/backfill-app-mappings.ts",
    "db:recover": "dotenvx run -- tsx src/ops/dbRecoverCli.ts",
    "env:check": "dotenvx run -- node -e \"console.log('DISCORD_TOKEN?', (process.env.DISCORD_TOKEN||'').slice(0,10)+'...')\"",
    "linked-roles:register": "dotenvx run -- tsx scripts/register-role-metadata.ts",
    "linked-roles:server": "dotenvx run -- tsx src/web/linkedRoles.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "docs:schema": "node scripts/gen-schema-doc.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.78.0",
    "better-sqlite3": "^12.4.1",
    "canvas": "^3.2.3",
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "fast-uri": ">=4.2.3",
    "minimatch": ">=9.0.7",
    "brace-expansion": ">=5.0.13",
    "ws": ">=8.20.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@eslint/js": "^9.38.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.45.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
