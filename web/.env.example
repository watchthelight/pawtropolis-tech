# Pawtropolis Web Dashboard — Environment Variables
# Copy to .env and fill in values

# Discord OAuth2
DISCORD_CLIENT_ID=             # Discord application client ID
DISCORD_CLIENT_SECRET=         # Discord application client secret
OAUTH2_REDIRECT_URI=           # e.g. https://pawtropolis.tech/auth/callback

# Discord Server
GUILD_ID=                      # Discord server (guild) ID

# Database
DB_PATH=                       # Path to SQLite database (default: ../data/data.db)

# Session Encryption
SESSION_SECRET=                # Session cookie encryption key (openssl rand -base64 32)

# Internal Secrets
INTERNAL_SECRET=               # Bot → Dashboard webhook auth (openssl rand -base64 32)
                               # Must match the value set in the bot's .env
                               # Used by: POST /api/internal/events (X-Internal-Secret header)

# Bot Dashboard API
BOT_API_URL=http://localhost:3003   # Bot's Fastify API URL
BOT_API_SECRET=                     # Shared secret for dashboard → bot auth (X-Dashboard-Secret)
                                    # Must match DASHBOARD_API_SECRET in the bot's .env

# Sentry — error tracking for the dashboard (Phase 1.4+)
# Project: pawtropolis-web (separate from the bot's Sentry project)
# DSN is a write-only public key — safe to expose to the browser via PUBLIC_ prefix.
# Get the actual value from CREDENTIALS.md under "Sentry → Dashboard project".
PUBLIC_SENTRY_DSN=             # https://<key>@o<org>.ingest.us.sentry.io/<project>

