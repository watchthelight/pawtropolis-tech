# Pawtropolis Web Dashboard: environment variables
# Copy to .env and fill in values. Every key here is read by web/src; the parity test
# tests/docs/env-example.test.ts fails when this file and the code disagree.

# Discord OAuth2
DISCORD_CLIENT_ID=             # Discord application client ID
DISCORD_CLIENT_SECRET=         # Discord application client secret
OAUTH2_REDIRECT_URI=           # e.g. https://pawtropolis.tech/auth/callback

# Discord Server
GUILD_ID=                      # Discord server (guild) ID

# Database
DB_PATH=                       # Path to SQLite database (default: ../data/data.db)
BOOKMARKS_DB_PATH=             # Handbook bookmarks store (default: next to DB_PATH)
PUSH_DB_PATH=                  # Web push subscriptions store (default: next to DB_PATH)
ART_UPLOADS_DIR=               # Art job upload directory (default: ./data/art-uploads)

# Session Encryption
SESSION_SECRET=                # Session cookie encryption key (openssl rand -base64 32)

# Internal Secrets
INTERNAL_SECRET=               # Bot -> Dashboard webhook auth (openssl rand -base64 32)
                               # Must match the value set in the bot's .env
                               # Used by: POST /api/internal/events (X-Internal-Secret header)

# Bot Dashboard API
BOT_API_URL=http://localhost:3003   # Bot's Fastify API URL
BOT_API_SECRET=                     # Shared secret for dashboard -> bot auth (X-Dashboard-Secret)
                                    # Must match DASHBOARD_API_SECRET in the bot's .env

# Review profile proxy (optional): a Discord profile proxy for reviewer cards
DISCORD_PROFILE_PROXY_URL=     # Base URL of the proxy; unset disables the feature
DISCORD_PROFILE_PROXY_SECRET=  # Shared secret sent to the proxy

# Cache (optional)
CACHE_BACKEND=memory           # memory (L1 only, default) or valkey (L1 + L2)
CACHE_URL=                     # redis:// or valkey:// URL when CACHE_BACKEND=valkey

# Web push (optional): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                 # mailto: or https: contact (default: https://pawtropolis.tech)

# Sentry: error tracking for the dashboard (separate project from the bot)
# DSN is a write-only public key, safe to expose to the browser via the PUBLIC_ prefix.
# Get the actual value from CREDENTIALS.md under "Sentry -> Dashboard project".
PUBLIC_SENTRY_DSN=             # https://<key>@o<org>.ingest.us.sentry.io/<project>
