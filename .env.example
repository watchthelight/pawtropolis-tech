# ============================================================================
# Core Bot Configuration (REQUIRED)
# ============================================================================

NODE_ENV=production

# Discord bot token - get from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application ID - same as bot client ID
CLIENT_ID=1490507577614663876

# Guild ID - leave empty to register commands globally
GUILD_ID=896070888594759740

# SQLite database path (auto-created)
DB_PATH=./data/data.db

# Reset password for /gate reset command (plaintext)
RESET_PASSWORD=choose-a-strong-password

# ============================================================================
# Web Control Panel / OAuth2 (REQUIRED for dashboard)
# ============================================================================

# Discord OAuth2 credentials - get from https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=1490507577614663876
DISCORD_CLIENT_SECRET=your-client-secret

# OAuth2 redirect URI
# Production: https://pawtropolis.tech/auth/callback
# Development: http://localhost:3000/auth/callback
DASHBOARD_REDIRECT_URI=https://pawtropolis.tech/auth/callback

# Admin role IDs (comma-separated) - users must have one of these roles to access dashboard
ADMIN_ROLE_ID=1402989891830153269

# Fastify session secret (min 32 chars) - generate with: openssl rand -base64 32
FASTIFY_SESSION_SECRET=your-32-char-secret-here

# Dashboard port
DASHBOARD_PORT=3000

# Trust proxy headers (1=true, 0=false) - enable when behind nginx/cloudflare
TRUST_PROXY=1

# CORS origin for production
CORS_ORIGIN=https://pawtropolis.tech

# Dashboard API secret - shared between bot and web for mutation auth
# Generate with: openssl rand -base64 32
DASHBOARD_API_SECRET=your-dashboard-api-secret-here

# Dashboard API port (bot-side Fastify server for mutations)
DASHBOARD_API_PORT=3003

# Dashboard web URL (bot → dashboard SSE notifications)
DASHBOARD_WEB_URL=http://localhost:3000

# Internal secret for bot → dashboard webhook auth (X-Internal-Secret header)
# Must match INTERNAL_SECRET in the web dashboard's .env
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=

# ============================================================================
# Optional Configuration
# ============================================================================

# Default logging channel for action_log embeds (can be overridden per-guild via /config)
LOGGING_CHANNEL=1430015254053654599

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
# Profiling loads a native module and samples every traced transaction; leave at 0 unless investigating CPU.
SENTRY_PROFILES_SAMPLE_RATE=0

# Pino log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Show NSFW Avatar Chance on review cards (1=show, 0=hide)
GATE_SHOW_AVATAR_RISK=0

# /say command access control (optional)
# Comma-separated role IDs that can use /say (in addition to ManageMessages permission)
SEND_ALLOWED_ROLE_IDS=

# Owner user IDs for elevated permissions (optional, comma-separated)
OWNER_IDS=

# ============================================================================
# Web Push Notifications (optional — required for mobile push)
# ============================================================================

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pawtropolis.tech

# ============================================================================
# Thin Line Verification (optional — first responder / military cosmetic role)
# ============================================================================

# Discord role ID to grant on successful /verify
IDME_VERIFIED_ROLE_ID=

# ============================================================================
# Test/Development (optional)
# ============================================================================

# Optional: channel to receive manual flag alerts from /flag command
FLAGGED_REPORT_CHANNEL_ID=

# TEST values used by seed scripts
TEST_GUILD_ID=
TEST_REVIEWER_ROLE_ID=

# ============================================================================
# GitHub Discord Badge System
# ============================================================================
# Public SVG badges that render Discord roles/channels in GitHub Markdown.
# All defaults below keep local dev working; only override in production.

# Public base URL stamped into the manifest
PUBLIC_BADGE_BASE_URL=https://status.pawtropolis.tech

# Toggle the public badge HTTP server
BADGE_ENDPOINT_ENABLED=true

# Port the badge server listens on (separate from /api/status)
BADGE_PORT=3004

# Refresh cadence in hours (Discord names + role colors)
BADGE_REFRESH_INTERVAL_HOURS=24

# Off by default. When true, /badges/roles/:id.svg, /badges/channels/:id.svg,
# and /badges/users/:id.svg become callable for any guild ID. Leave false in
# production unless you know what you are exposing.
BADGE_ALLOW_DIRECT_DISCORD_ID_ROUTES=false

# Filesystem locations (kept under data/ so they sit alongside the SQLite db)
BADGE_GENERATED_DIR=data/badges/generated
BADGE_MANIFEST_PATH=data/badges/manifest.json

# ============================================================================
# Litestream → Cloudflare R2 (continuous SQLite backup, Phase 1.1+)
# ============================================================================
# These vars are consumed by /etc/litestream.yml on the production EC2 box,
# NOT by the bot itself. The bot continues to read data/data.db directly.
# Litestream runs as a separate systemd unit and tails the SQLite WAL.
#
# Get the actual values from CREDENTIALS.md (gitignored) under
# "Cloudflare → R2 — pawtropolis-litestream". The R2 token is scoped to
# read+write the pawtropolis-litestream bucket only — limited blast radius.

# Cloudflare account ID (used to construct the S3 endpoint URL)
LITESTREAM_R2_ACCOUNT_ID=

# R2 access key ID (account API token, "Object Read & Write" scope)
LITESTREAM_ACCESS_KEY_ID=

# R2 secret access key (only shown once at token creation)
LITESTREAM_SECRET_ACCESS_KEY=

# ============================================================================
# NSFW / safety vendor APIs (avatar + content scanning)
# ============================================================================
# Google Cloud Vision (primary inference path for avatar NSFW scoring)
GOOGLE_VISION_API_KEY=

# Sightengine (secondary / failover content moderation)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# HIVE Moderation (alternate vendor; used by health check probes)
HIVE_API_KEY=

# Optic (alternate vendor; used by health check probes)
OPTIC_API_KEY=

# Enable/disable NSFW tagging pipeline. Default off; set true to activate.
NSFW_TAGGER_ENABLE=false

# ============================================================================
# Anthropic API (offline ML labeling via scripts/llm-label.mjs)
# ============================================================================
# Not required at runtime. Used only when running the gold-set labeler script.
ANTHROPIC_API_KEY=

# ============================================================================
# GitHub bot (for automated commits like badge refresh)
# ============================================================================
GITHUB_BOT_USERNAME=
GITHUB_BOT_EMAIL=
GITHUB_BOT_TOKEN=
GITHUB_REPO=watchthelight/pawtropolis-tech

# ============================================================================
# Deploy / SSH (deploy.sh)
# ============================================================================
# Comma-separated list of SSH host aliases the deploy script may target.
SSH_HOSTS=bash-ec2
# Single host override (used by some helper scripts).
REMOTE_SSH=bash-ec2
# Human label for the current bot instance (e.g. prod, staging, local).
BOT_LOCATION=local

# ============================================================================
# Dashboard API CSRF defense
# ============================================================================
# Comma-separated allowlist of Origin headers permitted to make state-changing
# requests (POST/PUT/PATCH/DELETE) against the bot's dashboardApi. Requests
# without an Origin header (server-to-server) are allowed by the secret alone.
DASHBOARD_ALLOWED_ORIGINS=https://pawtropolis.tech

# ============================================================================
# Behavior tuning
# ============================================================================
# Suppress new-member welcome embeds for the first N days after a member joins.
SILENT_FIRST_MSG_DAYS=0

# --- Performance / housekeeping knobs (all optional) ---
# Off-process PRAGMA quick_check cadence (hours). Runs in a child node process.
DB_INTEGRITY_INTERVAL_HOURS=6
# Security audit cadence (minutes). The audit reads the member cache and skips writes when unchanged.
SECURITY_AUDIT_INTERVAL_MINUTES=360
# Patreon stacked-role sweep cadence (minutes); guildMemberUpdate handles the live cases.
PATREON_SWEEP_INTERVAL_MINUTES=60
# Mod metrics (slash-command leaderboards) recalculation cadence (minutes).
MOD_METRICS_INTERVAL_MINUTES=60
# Warn in the log when event-loop p99 delay for the last minute exceeds this many ms.
LOOP_LAG_WARN_P99_MS=250
# Retention scheduler deletes expired rows only when true; otherwise it logs a daily dry run.
RETENTION_ENABLED=false
