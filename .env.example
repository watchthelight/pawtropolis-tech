# ============================================================================
# Core Bot Configuration (REQUIRED)
# ============================================================================

NODE_ENV=production

# Discord bot token - get from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application ID - same as bot client ID
CLIENT_ID=1490507577614663876

# Guild ID - leave empty to register commands globally
GUILD_ID=896070888594759740

# SQLite database path (auto-created)
DB_PATH=./data/data.db

# Reset password for /gate reset command (plaintext)
RESET_PASSWORD=choose-a-strong-password

# ============================================================================
# Web Control Panel / OAuth2 (REQUIRED for dashboard)
# ============================================================================

# Discord OAuth2 credentials - get from https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=1490507577614663876
DISCORD_CLIENT_SECRET=your-client-secret

# OAuth2 redirect URI
# Production: https://pawtropolis.tech/auth/callback
# Development: http://localhost:3000/auth/callback
DASHBOARD_REDIRECT_URI=https://pawtropolis.tech/auth/callback

# Admin role IDs (comma-separated) - users must have one of these roles to access dashboard
ADMIN_ROLE_ID=1402989891830153269

# Fastify session secret (min 32 chars) - generate with: openssl rand -base64 32
FASTIFY_SESSION_SECRET=your-32-char-secret-here

# Dashboard port
DASHBOARD_PORT=3000

# Trust proxy headers (1=true, 0=false) - enable when behind nginx/cloudflare
TRUST_PROXY=1

# CORS origin for production
CORS_ORIGIN=https://pawtropolis.tech

# Dashboard API secret - shared between bot and web for mutation auth
# Generate with: openssl rand -base64 32
DASHBOARD_API_SECRET=your-dashboard-api-secret-here

# Dashboard API port (bot-side Fastify server for mutations)
DASHBOARD_API_PORT=3003

# Dashboard web URL (bot → dashboard SSE notifications)
DASHBOARD_WEB_URL=http://localhost:3000

# Internal secret for bot → dashboard webhook auth (X-Internal-Secret header)
# Must match INTERNAL_SECRET in the web dashboard's .env
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=

# ============================================================================
# Optional Configuration
# ============================================================================

# Default logging channel for action_log embeds (can be overridden per-guild via /config)
LOGGING_CHANNEL=1430015254053654599

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1

# Pino log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=trace

# Show NSFW Avatar Chance on review cards (1=show, 0=hide)
GATE_SHOW_AVATAR_RISK=0

# /say command access control (optional)
# Comma-separated role IDs that can use /say (in addition to ManageMessages permission)
SEND_ALLOWED_ROLE_IDS=

# Owner user IDs for elevated permissions (optional, comma-separated)
OWNER_IDS=

# ============================================================================
# Web Push Notifications (optional — required for mobile push)
# ============================================================================

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pawtropolis.tech

# ============================================================================
# Thin Line Verification (optional — first responder / military cosmetic role)
# ============================================================================

# Discord role ID to grant on successful /verify
IDME_VERIFIED_ROLE_ID=

# ============================================================================
# Test/Development (optional)
# ============================================================================

# Optional: channel to receive manual flag alerts from /flag command
FLAGGED_REPORT_CHANNEL_ID=

# TEST values used by seed scripts
TEST_GUILD_ID=
TEST_REVIEWER_ROLE_ID=

# ============================================================================
# Litestream → Cloudflare R2 (continuous SQLite backup, Phase 1.1+)
# ============================================================================
# These vars are consumed by /etc/litestream.yml on the production EC2 box,
# NOT by the bot itself. The bot continues to read data/data.db directly.
# Litestream runs as a separate systemd unit and tails the SQLite WAL.
#
# Get the actual values from CREDENTIALS.md (gitignored) under
# "Cloudflare → R2 — pawtropolis-litestream". The R2 token is scoped to
# read+write the pawtropolis-litestream bucket only — limited blast radius.

# Cloudflare account ID (used to construct the S3 endpoint URL)
LITESTREAM_R2_ACCOUNT_ID=

# R2 access key ID (account API token, "Object Read & Write" scope)
LITESTREAM_ACCESS_KEY_ID=

# R2 secret access key (only shown once at token creation)
LITESTREAM_SECRET_ACCESS_KEY=
