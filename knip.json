{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/ops/*.ts", "scripts/**/*.{ts,mjs,cjs,js}", "migrations/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs,cjs,js}", "migrations/*.ts", "tests/**/*.ts"],
      "ignore": ["web/**"],
      "ignoreDependencies": [
        "pino-pretty",
        "@sveltejs/kit"
      ]
    },
    "web": {
      "project": ["src/**/*.{ts,svelte,js,css}"]
    }
  }
}
